SERVER_PORT=8080
DNS_UI_ORIGIN=http://localhost:3000
DNS_REMOTE_HOST=8.8.8.8
#Puerto 5432 (Session Pooler) — Hibernate necesita prepared statements de sesión.
#sslmode=require explícito en la URL
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project_ref>
SUPABASE_DB_PASSWORD=<password_percent_encoded_si_aplica>
